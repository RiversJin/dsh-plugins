{
  "name": "@riversjin/dsh-trajectory",
  "version": "0.2.4",
  "description": "Model-directed work and review anchors with durable archives and supplied-range tracking for DSH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RiversJin/dsh-plugins.git",
    "directory": "packages/dsh-trajectory"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-session-query": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-format-catalog": "0.2.1-rc.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
