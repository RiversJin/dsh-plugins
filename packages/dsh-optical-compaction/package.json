{
  "name": "dsh-optical-compaction",
  "version": "0.3.2",
  "description": "DSH port of OMP Snapcompact bitmap-frame context compaction",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RiversJin/dsh-plugins.git",
    "directory": "packages/dsh-optical-compaction"
  },
  "bugs": {
    "url": "https://github.com/RiversJin/dsh-plugins/issues"
  },
  "homepage": "https://github.com/RiversJin/dsh-plugins/tree/main/packages/dsh-optical-compaction#readme",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "FUSION-OFL.txt",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.json && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/assets', 'lib/assets', { recursive: true });\"",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.95",
    "@oh-my-pi/pi-natives": "18.0.10"
  },
  "optionalDependencies": {
    "@oh-my-pi/pi-natives-darwin-arm64": "18.0.10",
    "@oh-my-pi/pi-natives-darwin-x64": "18.0.10",
    "@oh-my-pi/pi-natives-linux-arm64": "18.0.10",
    "@oh-my-pi/pi-natives-linux-x64": "18.0.10",
    "@oh-my-pi/pi-natives-win32-x64": "18.0.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "compaction",
    "vision",
    "optical-compression"
  ],
  "license": "MIT"
}
